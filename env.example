# =============================================================================
#  PAINEL DE RECEBIMENTO — configuração
# -----------------------------------------------------------------------------
#  Copie este arquivo para ".env", preencha os valores e rode:
#
#      node scripts/gerar-config.mjs        (ou: python3 scripts/gerar-config.py)
#
#  O comando gera "assets/js/config.js", que é o arquivo realmente lido pelo
#  navegador. O ".env" NUNCA vai para o servidor — ele fica só na sua máquina
#  e no cofre de secrets do GitHub.
#
#  LEIA ISTO: qualquer valor com prefixo APP_ acaba dentro do config.js e,
#  portanto, é visível para quem abrir o painel e olhar o código-fonte. Isso é
#  inevitável em aplicação que roda no navegador. Por isso só entram aqui
#  valores publicáveis. Chaves secretas ficam nas variáveis sem prefixo APP_,
#  que o gerador se recusa a publicar.
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLICÁVEL — vai para o navegador
# -----------------------------------------------------------------------------

# Supabase > Project Settings > Data API > Project URL
APP_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...)
# Esta chave é feita para ficar exposta; quem protege os dados é a RLS do banco.
APP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Identificação da aplicação
APP_NOME=Recebimento
APP_DESCRICAO=Programação e entrada de materiais
APP_VERSAO=1.0.0

# Ambiente: producao | homologacao | desenvolvimento
APP_AMBIENTE=producao

# Janela de recebimento — minutos desde a meia-noite.
# 1º corte: a partir daí a entrega do dia passa a "ATRASANDO".
# 2º corte: a partir daí passa a "ATRASADO".
APP_CORTE_SEMANA_1=14:00
APP_CORTE_SEMANA_2=15:50
APP_CORTE_SABADO_1=10:00
APP_CORTE_SABADO_2=11:30

# Feriados sem recebimento (AAAA-MM-DD, separados por vírgula).
# Domingos já são pulados automaticamente.
APP_FERIADOS=2026-01-01,2026-02-16,2026-02-17,2026-04-03,2026-04-21,2026-05-01,2026-06-04,2026-09-07,2026-10-12,2026-11-02,2026-11-15,2026-11-20,2026-12-25,2027-01-01

# Ritmo de atualização do painel, em segundos
APP_INTERVALO_SYNC=15
APP_INTERVALO_RELOGIO=30

# Duração da sessão do operador, em horas (precisa bater com o SQL)
APP_SESSAO_HORAS=12

# -----------------------------------------------------------------------------
# SECRETO — nunca é publicado. O gerador aborta se tentar.
# Fica aqui só para uso administrativo (rodar SQL, scripts de manutenção).
# -----------------------------------------------------------------------------

# Supabase > Project Settings > API Keys > Secret key (sb_secret_...)
SUPABASE_SECRET_KEY=

# Supabase > Project Settings > Database > Connection string
SUPABASE_DB_URL=
